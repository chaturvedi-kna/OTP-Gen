stats.tmp
stats.*.tmp
state.json
state.*.json
state.tmp
state.*.tmp
pending_cancels.json
pending_cancels.*.json
pending_cancels.*.tmp
.signals/
.signals-*/
.venv/

# Persistent complaint evidence (cancel refused + late OTP), per-instance too.
cancel_refused_otp.jsonl
cancel_refused_otp.*.jsonl
